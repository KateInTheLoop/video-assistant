{
  "manifest_version": 3,
  "name": "Interview Coach",
  "version": "0.2.0",
  "description": "Live captions and structure hints for video interviews, grounded in your own CV and stories.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.deepgram.com/*",
    "https://streaming.assemblyai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Interview Coach"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icons/icon128.png"
  }
}
